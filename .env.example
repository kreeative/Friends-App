# Copy to .env for local development. On Netlify these go in the dashboard
# instead (Site configuration > Environment variables) not in the repo.
#
# The prefix must be VITE_. This is a Vite app, so NEXT_PUBLIC_* names are
# ignored entirely and the app boots to "Supabase is not configured".
#
# Both values are safe in the client bundle: the publishable/anon key only
# grants what the RLS policies in supabase/03_policies.sql allow. The
# service_role key is a different thing entirely and must never appear here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
